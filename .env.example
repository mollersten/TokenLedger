# The real database. The server and the admin CLI use DATABASE_URL.
# On Supabase, use the Session pooler connection string (port 5432, not the
# 6543 transaction pooler). For local runs (smoke tests, load tests), prefix
# the command with scripts/with-local-db.sh instead of editing this.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Supabase's session pooler allows 15 sessions on the smallest compute size,
# so keep the server's pool below that (the default is 10). With several
# instances, split the 15 between them. TLS is required for any database that
# is not on this machine unless the string sets sslmode= itself.
DATABASE_MAX_CONNECTIONS=10

# Database used by `cargo test` and the load test. Must be on this machine:
# the test harness refuses anything else. Matches docker-compose.yml and
# scripts/local-pg.sh.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tokenledger

BIND_ADDR=127.0.0.1:8080
REAPER_INTERVAL_MS=2000
RUST_LOG=info

# Auth: how long API key lookups (and account status/limits) are cached per
# server. Revocations and limit changes take effect within this window.
AUTH_CACHE_TTL_MS=30000
# How often per-account request counts are written to account_usage.
USAGE_FLUSH_INTERVAL_MS=5000

# Safety ceilings on POST /v1/import, per account and UTC day. Imports don't
# count toward plan limits; these only stop runaway or malicious clients.
IMPORT_CUSTOMERS_PER_DAY=1000000
IMPORT_PURCHASES_PER_DAY=50000000

# How long a retried request (same Idempotency-Key) replays its first answer.
# Charging once per item doesn't depend on this. 0 keeps them forever.
IDEMPOTENCY_RETENTION_HOURS=24
