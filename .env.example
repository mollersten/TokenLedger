# Database the server connects to. Local default matches docker-compose.yml
# and scripts/local-pg.sh. To run against Supabase, set this to your Session
# pooler connection string (port 5432, not the 6543 transaction pooler).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tokenledger

# Database used by `cargo test`. Deliberately separate from DATABASE_URL so the
# test suite never writes into a remote database by accident.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tokenledger

BIND_ADDR=127.0.0.1:8080
DATABASE_MAX_CONNECTIONS=20
REAPER_INTERVAL_MS=2000
RUST_LOG=info,backend=debug

# Auth: how long API key lookups (and account status/limits) are cached per
# server. Revocations and limit changes take effect within this window.
AUTH_CACHE_TTL_MS=30000
# How often per-account request counts are written to account_usage.
USAGE_FLUSH_INTERVAL_MS=5000
